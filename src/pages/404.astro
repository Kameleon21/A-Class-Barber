---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Page Not Found - A Class Barber" description="The page you are looking for could not be found.">
    <Header />
    <section class="bg-black text-white pt-32 md:pt-40 pb-20">
        <div class="max-w-6xl mx-auto px-4 text-center">
            <div class="flex justify-center mb-16">
                <h1 class="text-4xl md:text-5xl font-serif font-extrabold text-center inline-block border-t border-b border-[#c19d65] py-4 px-12">Page Not Found</h1>
            </div>
            <p class="text-lg leading-relaxed mb-8">Sorry, we couldn't find the page you were looking for.</p>
            <a href="/" class="text-lg text-[#c19d65] hover:underline">Back to home</a>
        </div>
    </section>
</Layout>
