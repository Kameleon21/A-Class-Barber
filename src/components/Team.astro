---
import { Image } from 'astro:assets';
import image1 from '../assets/barber-2.jpeg';
import image2 from '../assets/barber-1.jpeg';
import image3 from '../assets/barber-3.jpeg';
import image4 from '../assets/barber-4.jpeg';
import SectionHeading from './SectionHeading.astro';

const teamMembers = [
    {
        image: image1,
        name: "Ahmed",
        role: "Owner",
        imageStyle: "object-cover object-[center_40%] md:scale-125 md:hover:scale-100 transition-transform duration-300"
    },
    {
        image: image2,
        name: "Emil",
        role: "Barber",
        imageStyle: "object-cover object-[center_35%] md:scale-125 md:hover:scale-100 transition-transform duration-300"
    },
    {
        image: image3,
        name: "Ghilas",
        role: "Barber",
        imageStyle: "object-cover object-[center_30%] md:scale-125 md:hover:scale-100 transition-transform duration-300"
    },
    {
        image: image4,
        name: "Alin",
        role: "Barber",
        imageStyle: "object-cover object-[left_30%] md:scale-125 md:hover:scale-100 transition-transform duration-300"
    }
];
---

<section id="team" class="w-full bg-black text-white pt-32 md:pt-40 pb-20">
    <div class="max-w-[1920px] mx-auto px-4 sm:px-8">
        {/* Meet The Team Section */}
        <SectionHeading title="Meet The Team" />

        {/* Team Members Grid */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-32">
            {teamMembers.map(member => (
                <div class="reveal group flex flex-col items-center">
                    <div class="w-64 h-64 rounded-2xl overflow-hidden mb-5 ring-1 ring-white/15 ring-offset-4 ring-offset-black transition-shadow duration-300 group-hover:ring-tertiary">
                        <Image 
                            src={member.image}
                            alt={member.name}
                            width={400}
                            height={400}
                            class={member.imageStyle}
                            loading="lazy"
                            decoding="async"
                        />
                    </div>
                    <h3 class="text-2xl font-serif text-white mb-1">{member.name}</h3>
                    <p class="text-tertiary text-sm uppercase tracking-[0.25em]">{member.role}</p>
                </div>
            ))}
        </div>

        {/* White Divider */}
        <div class="w-full max-w-4xl mx-auto h-px bg-gradient-to-r from-transparent via-white/30 to-transparent mb-32"></div>

        {/* About Us Section */}
        <SectionHeading title="About Us" />

        {/* About Content */}
        <div id="about" class="reveal max-w-3xl mx-auto text-xl leading-relaxed space-y-6 text-secondary/90 scroll-mt-32 first-letter:float-left first-letter:font-serif first-letter:text-6xl first-letter:leading-[0.85] first-letter:pr-3 first-letter:text-tertiary">
            <p>
                Established in 2017 by the owner Ahmed Elallus, this thriving business is a testament to Ahmed’s passion for the art of barbering. With over 26 years of experience, Ahmed’s journey began when he was 14, supported by his family and friends who helped him open his first shop in his home town at the age of 18. After some time Ahmed moved to Ireland where he opened his A class barbers, located in the heart of Waterford City.
            </p>
            <p>
                Ahmed’s barbershop has become a beloved hub for the community, offering a wide range of services catering to all ages. From traditional Turkish shaves to expert skin fading, Ahmed’s commitment to excellence and continuous self-improvement has earned him a reputation as a go-to destination for quality grooming services. 
            </p>
        </div>
    </div>
</section>