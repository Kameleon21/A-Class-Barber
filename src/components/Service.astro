---
import SectionHeading from './SectionHeading.astro';
import { serviceGroups } from '../data/services.js';
---

<section id="services" class="w-full bg-secondary text-primary py-20 scroll-mt-4">
    <div class="max-w-[1920px] mx-auto px-4 sm:px-8">
        <SectionHeading title="Services" />

        <div class="max-w-6xl mx-auto border border-black/30 p-1.5">
            <div class="border border-black/30 px-5 py-10 sm:px-10 md:px-14 md:py-14 grid md:grid-cols-2 gap-x-16 gap-y-14">
                {serviceGroups.map(group => (
                    <div class="reveal space-y-8">
                        <h3 class="text-3xl font-extrabold font-serif text-primary relative inline-block">
                            {group.title}
                            <span class="absolute -bottom-2 left-0 w-full h-0.5 bg-tertiary"></span>
                        </h3>
                        <ul class="space-y-4">
                            {group.items.map(service => (
                                <li class="menu-row text-xl">
                                    <span>{service.name}</span>
                                    <span class="leader" aria-hidden="true"></span>
                                    <span class="price font-semibold">{service.price}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>
